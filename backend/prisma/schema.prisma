generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DRIVER
  PARENT
  STUDENT
}

enum AttendanceStatus {
  BOARDED
  EXITED
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  driver    Driver?
  parent    Parent?
  student   Student?
}

model School {
  id      String  @id @default(cuid())
  name    String
  address String
  lat     Float
  lng     Float

  routes  Route[]
  buses   Bus[]
}

model Bus {
  id           String  @id @default(cuid())
  plateNumber  String  @unique
  capacity     Int
  schoolId     String
  school       School  @relation(fields: [schoolId], references: [id])

  driver        Driver?
  route         Route?
  locations     BusLocation[]
  attendances   Attendance[]
}

model Driver {
  id       String  @id @default(cuid())
  userId   String  @unique
  user     User    @relation(fields: [userId], references: [id])
  busId    String? @unique
  bus      Bus?    @relation(fields: [busId], references: [id])
  isActive Boolean @default(false)
}

model Route {
  id       String  @id @default(cuid())
  name     String
  schoolId String
  school   School  @relation(fields: [schoolId], references: [id])
  busId    String? @unique
  bus      Bus?    @relation(fields: [busId], references: [id])

  stops    Stop[]
  students Student[]
}

model Stop {
  id       String  @id @default(cuid())
  name     String
  lat      Float
  lng      Float
  order    Int
  routeId  String
  route    Route   @relation(fields: [routeId], references: [id])

  students Student[]
}

model Parent {
  id       String    @id @default(cuid())
  userId   String    @unique
  user     User      @relation(fields: [userId], references: [id])
  students Student[]
}

model Student {
  id        String  @id @default(cuid())
  userId    String  @unique
  user      User    @relation(fields: [userId], references: [id])
  parentId  String?
  parent    Parent? @relation(fields: [parentId], references: [id])
  routeId   String?
  route     Route?  @relation(fields: [routeId], references: [id])
  stopId    String?
  stop      Stop?   @relation(fields: [stopId], references: [id])

  nfcCardId   String?  @unique  // NFC card UID assigned to student
  attendances Attendance[]
}

model BusLocation {
  id        String   @id @default(cuid())
  busId     String
  bus       Bus      @relation(fields: [busId], references: [id])
  lat       Float
  lng       Float
  speed     Float?
  source    String   @default("app")  // "app" | "arduino"
  timestamp DateTime @default(now())
}

model Attendance {
  id        String           @id @default(cuid())
  studentId String
  student   Student          @relation(fields: [studentId], references: [id])
  busId     String
  bus       Bus              @relation(fields: [busId], references: [id])
  status    AttendanceStatus
  timestamp DateTime         @default(now())
}
