DATABASE_URL="postgresql://user:password@localhost:5432/bustracker"
JWT_SECRET="change-this-to-a-long-random-string-in-production"
PORT=3000

# Web admin origin(s) — comma-separated for multiple (e.g. localhost + hotspot IP).
# The mobile app (React Native) sends no Origin header so it is always allowed.
# Example with two origins:  CLIENT_URL="http://localhost:5173,http://172.20.197.199:5173"
CLIENT_URL="http://localhost:5173"

# Arduino device authentication key — shared between all Arduino devices for now.
# Replace with per-device keys before production.
ARDUINO_DEVICE_KEY="change-this-arduino-key"
